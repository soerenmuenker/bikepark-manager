// What bars and shops sell (ProductType). Copied into the world when a scenario starts. The park sets one price per
// product (Finances menu → Prices; it starts at referencePriceCents, at most maxPriceCents). Guests compare the price with
// the reference: elasticityPermille is how much of the buy chance each reference price above it removes (1000: double
// price, no sales; cheaper adds up to +50 %); paying above the reference costs a little mood and lowers the value part of
// their review. goodsCostPermille: what one sale costs the park in goods.
// lunch: sat down for minMinutes..maxMinutes once per visit (bar seats). merch: bought in shops by guests going home.
// Others are impulse buys: impulsePermille per minute between laps at a bar (scaled up for a stop on the way to a trail,
// facilityRules.stopScalePermille), only by guests with less energy than whenEnergyBelow. Effects: energy and happiness
// (0..1000), alcohol (bolder trail choices and more crashes, wears off by the minute), caffeineMinutes (climbing costs
// half the energy meanwhile). Catalog order is the order guests consider things in.
[
  { "id": "lunch", "name": "Lunch", "referencePriceCents": 1400, "maxPriceCents": 4000, "goodsCostPermille": 200,
    "elasticityPermille": 800, "energy": 250, "happiness": 40, "lunch": true, "minMinutes": 30, "maxMinutes": 50 },
  { "id": "coffee", "name": "Coffee", "referencePriceCents": 350, "maxPriceCents": 1200, "goodsCostPermille": 100,
    "elasticityPermille": 900, "energy": 150, "happiness": 10, "caffeineMinutes": 60, "impulsePermille": 20, "whenEnergyBelow": 800 },
  { "id": "beer", "name": "Beer", "referencePriceCents": 500, "maxPriceCents": 1500, "goodsCostPermille": 250,
    "elasticityPermille": 600, "happiness": 30, "alcohol": 250, "impulsePermille": 6 },
  { "id": "radler", "name": "Radler", "referencePriceCents": 450, "maxPriceCents": 1500, "goodsCostPermille": 250,
    "elasticityPermille": 700, "energy": 30, "happiness": 20, "alcohol": 100, "impulsePermille": 4 },
  { "id": "snack", "name": "Snack", "referencePriceCents": 400, "maxPriceCents": 1500, "goodsCostPermille": 200,
    "elasticityPermille": 1000, "energy": 50, "happiness": 15, "impulsePermille": 8 },
  { "id": "merch", "name": "Merch", "referencePriceCents": 2500, "maxPriceCents": 10000, "goodsCostPermille": 450,
    "elasticityPermille": 1000, "merch": true }
