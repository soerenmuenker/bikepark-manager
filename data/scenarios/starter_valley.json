{
  "id": "starter_valley",
  "name": "Starter Valley",
  "description": "Career: you start on the old beginner ski hill at the foot of the mountain, with a rusty T-bar and a gravel track. Restore the lift, build your first trails, earn a reputation and buy more land: the Alpine Lift Co. gondola only rents you bike access once you own the land at both its stations.",
  "seed": 1337,
  "parkName": "Old Ski Hill Bikepark",
  "startingMoneyCents": 15000000,
  "entryFeeCents": 1500,
  "liftTicketCents": 1000,
  // Daily rhythm (minutes of the day): open 09:00-18:00, then 45 min of last rides; the gondola warms up from 08:30.
  // Arrivals follow the profile (permille of baseArrivalPermille): a morning rush, tapering off in the afternoon.
  // Guests take one lunch break between 11:00 and 13:00.
  "rules": {
    "openMinute": 540,
    "closeMinute": 1080,
    "lastRideMinutes": 45,
    "liftWarmupMinutes": 30,
    "baseArrivalPermille": 700,
    "arrivalProfile": [
      { "minute": 540, "permille": 1600 },
      { "minute": 660, "permille": 1400 },
      { "minute": 780, "permille": 800 },
      { "minute": 900, "permille": 400 },
      { "minute": 990, "permille": 0 }
    ],
    "lunchStartMinute": 660,
    "lunchEndMinute": 780,
    "lunchMinMinutes": 30,
    "lunchMaxMinutes": 50,
    "lunchPriceCents": 1400,
    "referenceEntryFeeCents": 1500,
    "maxEntryFeeCents": 10000,
    "capacity": 150,
    "dailyUpkeepCents": 25000,
    "snackPriceCents": 400
  },
  // Building rules and rider tuning (TrailRules). Gradients in tenths of the -10..+10 gradient score
  // (1 point = 9°; 40 = 4.0 = 36°): beyond "max" a way can't be built, beyond "steep" it only warns.
  // Speeds in cm/s, energy on 0..1000.
  "trailRules": {
    "segmentLengthMeters": 10,
    "snapRadiusMeters": 12,
    "maxLengthMeters": 4000,
    "pathGradingMeters": 25,
    "pathMaxGradient": 40,
    "pathSteepGradient": 20,
    "trailMaxDropGradient": 80,
    "trailSteepDropGradient": 50,
    "trailMaxClimbGradient": 30,
    "trailSteepClimbGradient": 15,
    "pathCorridorCm": 400,
    "trailCorridorCm": 200,
    "climbSpeedMinCmPerS": 110,
    "climbSpeedMaxCmPerS": 300,
    "descentSpeedMinCmPerS": 300,
    "descentSpeedMaxCmPerS": 900,
    "climbEnergyPerMeterGain": 2,
    "descentEnergyPer100Meters": 3,
    "tiredEnergy": 150,
    // Trail traffic: no overtaking on trails (only on gravel paths); riders keep this gap, wait a moment at the trail
    // entrance (letting faster riders waiting there go first) and lose mood while held up behind a slower rider.
    "riderGapCm": 500,
    "entryWaitSeconds": 10,
    "heldUpMoodPerMinute": 5
  },
  // Weather: each day is rolled at midnight from these odds (permille), tomorrow's is the forecast. Rain wets the ground
  // (wetness 0..1000), which dries afterwards; fewer guests come on bad days and riders in the rain lose mood.
  "weatherRules": {
    "sunnyPermille": 400,
    "cloudyPermille": 300,
    "showersPermille": 200,
    "rainPermille": 100,
    "showerMinHours": 1,
    "showerMaxHours": 3,
    "rainMinHours": 4,
    "rainMaxHours": 10,
    "wetPerRainMinute": 8,
    "dryPerMinuteSunny": 2,
    "dryPerMinuteCloudy": 1,
    "sunnyArrivalPermille": 1050,
    "cloudyArrivalPermille": 950,
    "showersArrivalPermille": 800,
    "rainArrivalPermille": 450,
    "rainMoodPerMinute": 1
  },
  // Wear: only trail features wear (the trail itself doesn't). Each rider passing a feature takes wearPerPass millionths
  // off its condition (more on harder features, up to 3x on wet ground). Below 70 % it is slower and less fun; below 20 %
  // the player gets a warning to send the crew; at 0 % the trail closes until the feature is repaired.
  "wearRules": {
    "wearPerPass": 120,
    "wetWearPermille": 2000,
    "roughBelowPermille": 700,
    "wornSpeedLossPermille": 300,
    "wornFunLoss": 400,
    "warnBelowPermille": 200
  },
  // Terrain is regenerated from these settings; "seed" defaults to the scenario seed.
  "terrain": {
    "sizeMeters": 1000,
    "baseElevationCm": 80000,
    "reliefCm": 35000,
    "peakXMeters": 600,
    "peakZMeters": 400,
    "peakRadiusMeters": 750,
    "ridgeCount": 3,
    "ridgeStrengthPermille": 300,
    "roughnessPermille": 90,
    "treeLineCm": 108000,
    "forestCoveragePermille": 650
  },
  // Reputation: leaving guests who rode may write a review (1-5 stars, in tenths). Riders are grouped by skill and each
  // group weights the aspects of a visit (permille, summing to 1000): fun (run fun + mood), safety (no runs on trails
  // far above their skill), smoothness (little queuing or being held up), challenge (hardest trail vs. the group's
  // target difficulty), jumps (fun on tables, doubles, kickers, drops), variety (distinct trails ridden) and value (runs
  // x fairCentsPerRun against the entry fee paid: at 1.50 € a run, a 15 € ticket needs ten runs). The
  // rating is the average of the last windowSize reviews per group, shown from minReviewsForRating reviews on.
  // Demand (permille of the arrival rate) = visibility (by all-time reviews) x rating factor (by stars) x influencer.
  // Influencers come now and then, ride the park, and post: a good post boosts demand, a bad one hurts, fading over
  // influencerEffectDays. Park XP is derived from built trail km, distinct trail ratings, distinct feature kinds and
  // the average visitors of the last visitorDays days; levelXp lists the XP for levels 1..20 (25 n^2 + 75 n: a demo park
  // with two trails is level 4, a dense network of ~50 km across the map with busy days reaches 20).
  "reputationRules": {
    "enabled": true,
    "intermediateFromSkill": 350,
    "expertFromSkill": 650,
    "groups": [
      { "group": "beginner", "name": "Beginners", "values": "Feeling safe and a smooth day: easy trails, no scary sections, little waiting, a fair price.",
        "fun": 250, "safety": 300, "smoothness": 200, "challenge": 0, "jumps": 0, "variety": 100, "value": 150, "challengeTarget": 250 },
      { "group": "intermediate", "name": "Intermediates", "values": "Flow and fun: well-shaped trails, some variety, a bit of challenge and air, good value for the ticket.",
        "fun": 300, "safety": 100, "smoothness": 150, "challenge": 100, "jumps": 100, "variety": 100, "value": 150, "challengeTarget": 480 },
      { "group": "expert", "name": "Experts", "values": "Technical difficulty and jump quality: red and black lines with good features.",
        "fun": 250, "safety": 0, "smoothness": 150, "challenge": 250, "jumps": 200, "variety": 100, "value": 50, "challengeTarget": 700 }
    ],
    "reviewChancePermille": 600,
    "windowSize": 200,
    "minReviewsForRating": 10,
    "scaredMargin": 150,
    "funFloor": 250,
    "funCeiling": 800,
    "heldUpWeight": 1,
    "waitPenaltyPermille": 2000,
    "varietyFullAt": 3,
    "fairCentsPerRun": 150,
    "visibilityCurve": [
      { "x": 0, "permille": 500 },
      { "x": 300, "permille": 750 },
      { "x": 1500, "permille": 1000 },
      { "x": 6000, "permille": 1200 }
    ],
    "ratingCurve": [
      { "x": 10, "permille": 700 },
      { "x": 30, "permille": 1000 },
      { "x": 50, "permille": 1300 }
    ],
    "demandMinPermille": 300,
    "demandMaxPermille": 1500,
    "influencerChancePermille": 250,
    "influencerFirstDay": 3,
    "influencerMinGapDays": 7,
    "influencerSkill": 750,
    "influencerStayMinutes": 300,
    "influencerPeakPermille": 400,
    "influencerNeutralTenths": 30,
    "influencerEffectDays": 5,
    "xpPerTrailKm": 150,
    "xpPerRating": 50,
    "xpPerFeatureKind": 25,
    "xpPerVisitor": 1,
    "visitorDays": 7,
    "levelXp": [100, 250, 450, 700, 1000, 1350, 1750, 2200, 2700, 3250, 3850, 4500, 5200, 5950, 6750, 7600, 8500, 9450, 10450, 11500]
  },
  // Crashes: every feature ridden and every 10 m of trail is a small chance to crash (parts per million), scaled by
  // factors in permille: difficulty above the rider's skill (+overSkillPer100Permille per 100 points, lower for easy
  // stuff), jumps, worn features (below the rough level, up to 1 + wornFactor at 0 %), wet ground and tired riders.
  // Passing a crossing while someone on the other way is close is a collision chance. A crash is serious with
  // seriousBase + extras (jumps, collisions, over skill): the rider lies on the trail, blocking it, until the rescue
  // helicopter (public service) has flown them out; otherwise they ride down slowly and go home. A rider hurt while
  // being pulled up a T-bar stops the whole lift: for towStopMinutes (minor: they get off the track and go home) or
  // until the helicopter has flown them out (serious). The insurance premium
  // is charged daily: a base plus a charge per accident of the last insuranceDays days.
  "crashRules": {
    "enabled": true,
    "featureBasePpm": 40,
    "jumpFactorPermille": 2000,
    "terrainBasePpm": 2,
    "overSkillPer100Permille": 1000,
    "minSkillFactorPermille": 150,
    "wornFactorPermille": 2000,
    "wetFactorPermille": 1000,
    "fatigueBelowEnergy": 350,
    "fatigueFactorPermille": 1000,
    "collisionPpm": 500,
    "crossingWindowCm": 1000,
    "seriousBasePermille": 50,
    "seriousJumpPermille": 50,
    "seriousCollisionPermille": 150,
    "seriousPer100OverSkillPermille": 40,
    "minorMoodLoss": 250,
    "seriousMoodLoss": 600,
    "minorSpeedCmPerS": 150,
    "towStopMinutes": 5,
    "helicopterMinMinutes": 25,
    "helicopterMaxMinutes": 50,
    "injuredReviewChancePermille": 900,
    "insuranceBaseCents": 5000,
    "insurancePerMinorCents": 1500,
    "insurancePerSeriousCents": 15000,
    "insuranceDays": 7
  },
  // Lift models come from the shared catalog.
  "liftTypesFile": "../lift_types.json",
  "trailFeaturesFile": "../trail_features.json",
  "toolsFile": "../tools.json",
  // Crew and building (CrewRules). Planned ways and features are built by crew jobs during work hours (07:30-17:30,
